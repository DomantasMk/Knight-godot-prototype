# Godot 4+ specific ignores
.godot/
.nomedia
/android/
.import/
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Export artifacts and secrets
export/
export.cfg
export_credentials.cfg
*.exe
*.pck
*.apk
*.aab
*.ipa
*.x86_64
*.x86_32
*.arm32
*.arm64
*.zip

# C# / .NET build output (if C# is enabled later)
.mono/
bin/
obj/
data_*/
mono_crash.*.json
*.csproj.user
*.sln.user

# IDE and OS files
.vs/
.idea/
*.swp
.DS_Store
Thumbs.db

# Machine-local notes and scratch work. Anything here may contain absolute paths
# and personal setup detail, which is exactly why it stays out of the repo.
local/

# Claude Code: settings.json is shared, settings.local.json holds this machine's
# tool paths (GODOT_BIN etc.) and stays out of the repo for the same reason.
.claude/settings.local.json
